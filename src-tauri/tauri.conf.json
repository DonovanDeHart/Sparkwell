{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sparkwell",
  "version": "0.1.0",
  "identifier": "com.sparkwell.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Sparkwell",
        "width": 436,
        "height": 820,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "focus": false,
        "center": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Sparkwell",
    "category": "Productivity",
    "shortDescription": "Your Sparks, always within reach.",
    "longDescription": "Sparkwell is a compact desktop companion that retrieves the right Spark for what you are trying to accomplish. Local-first: your library never leaves your device.",
    "copyright": "Copyright (c) 2026 Sparkwell",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
